# ==== Discord Application (https://discord.com/developers/applications) ====
# Bot -> Token  (ДЕРЖИ В СЕКРЕТЕ, не коммить)
DISCORD_TOKEN=твой_токен_бота
# General Information -> Application ID
CLIENT_ID=айди_приложения
# OAuth2 -> Client Secret
CLIENT_SECRET=секрет_приложения
# (опционально) ID сервера для мгновенной регистрации команд при разработке
# GUILD_ID=

# ==== Dashboard ====
DASHBOARD_URL=http://localhost:3000
# Должен ТОЧНО совпадать с Redirect в OAuth2 настройках приложения:
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# Любая длинная случайная строка для подписи сессий
SESSION_SECRET=поменяй_на_случайную_строку
PORT=3000

# ==== Supabase (Project Settings -> API) ====
SUPABASE_URL=https://ТВОЙ_ПРОЕКТ.supabase.co
# service_role ключ — ТОЛЬКО на сервере, даёт полный доступ в обход RLS.
# НИКОГДА не клади его во фронтенд и не коммить.
SUPABASE_SERVICE_KEY=твой_service_role_ключ
